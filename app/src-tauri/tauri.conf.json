{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HDM",
  "mainBinaryName": "hdm",
  "version": "0.1.0",
  "identifier": "com.ht.hdm",
  "build": {
    "beforeDevCommand": "npm --prefix ../hdm-ui run dev",
    "beforeBuildCommand": "npm --prefix ../hdm-ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../hdm-ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "HDM",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "HT Suite",
    "copyright": "Houssein",
    "category": "Utility",
    "shortDescription": "Houssein Download Manager",
    "longDescription": "HDM (Houssein Download Manager) is a fast, local-first multi-connection desktop download manager.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/prism-native-host",
      "binaries/aria2c"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "description": "BitTorrent metadata file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../packaging/windows/installer-hooks.nsh",
        "displayLanguageSelector": false
      },
      "wix": {
        "fragmentPaths": [
          "../../packaging/windows/native-host.wxs"
        ],
        "componentRefs": [
          "HdmNativeHostRegistration"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ],
        "files": {},
        "desktopTemplate": "../../packaging/linux/hdm.desktop",
        "postInstallScript": "../../packaging/linux/postinst.sh",
        "preRemoveScript": "../../packaging/linux/prerm.sh"
      },
      "rpm": {
        "depends": [
          "/usr/bin/ffmpeg"
        ],
        "desktopTemplate": "../../packaging/linux/hdm.desktop",
        "postInstallScript": "../../packaging/linux/postinst.sh",
        "preRemoveScript": "../../packaging/linux/prerm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "../../extension/build/chromium/": "extension/chromium/",
      "../../extension/build/firefox/": "extension/firefox/",
      "../../packaging/linux/README-extension.txt": "extension/README.txt"
    }
  }
}
