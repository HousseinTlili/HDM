<?xml version="1.0" encoding="utf-8"?>
<!-- HDM MSI fragment: browser native messaging registration + magnet: handler.
     Linked into Tauri's WiX template through bundle.windows.wix.fragmentPaths and
     componentRefs (HdmNativeHostRegistration). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="HdmNativeHostRegistration" Guid="A7D4F12C-8E3B-4A9D-B562-19C48E72D0F8">
        <RegistryKey Root="HKCU" Key="Software\Classes\magnet">
          <RegistryValue Type="string" Value="URL:Magnet link" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Classes\magnet\DefaultIcon" Type="string" Value="[INSTALLDIR]hdm.exe,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\magnet\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]hdm.exe&quot; &quot;%1&quot;" />
      </Component>
    </DirectoryRef>

    <!-- Run as the installing user (Impersonate) so HKCU and %APPDATA% are the user's. -->
    <CustomAction Id="HdmRegisterHost" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]prism-native-host.exe&quot; register"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="HdmUnregisterHost" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]prism-native-host.exe&quot; unregister"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- The browser keeps prism-native-host.exe running while the extension is connected;
         stop it so the file can be replaced or removed (the extension reconnects by itself). -->
    <CustomAction Id="HdmStopHost" Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]taskkill.exe&quot; /F /IM prism-native-host.exe"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="HdmStopHost" Before="InstallValidate" />
      <Custom Action="HdmRegisterHost" Before="InstallFinalize">NOT REMOVE</Custom>
      <Custom Action="HdmUnregisterHost" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
